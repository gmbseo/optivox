---
import { localePath, type Lang } from "@/i18n";
import { t } from "@/i18n/ui";
import Base from "@/layouts/Base.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const copy = {
  he: { title: "העמוד לא נמצא", body: "ייתכן שהקישור שגוי או שהעמוד הועבר.", home: "לדף הבית" },
  en: { title: "Page not found", body: "The link may be wrong, or the page may have moved.", home: "Go to the home page" },
}[lang];
---

<Base lang={lang} title={copy.title} description={copy.body} path="/404/" noindex>
  <section class="section bg-paper">
    <div class="container-site max-w-2xl text-center">
      <p class="text-6xl font-extrabold text-brand">404</p>
      <h1 class="mt-4 text-3xl font-bold sm:text-4xl">{copy.title}</h1>
      <p class="mt-4 text-lg text-muted-foreground">{copy.body}</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href={localePath(lang, "/")} class="btn-primary">{copy.home}</a>
        <a href={localePath(lang, "/services/")} class="btn-secondary">{ui.cta.services}</a>
      </div>
    </div>
  </section>
</Base>
