---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBand from "@/components/CtaBand.astro";
import Faq from "@/components/Faq.astro";
import Icon from "@/components/Icon.astro";
import { getService, type ServiceSlug } from "@/content/services";
import { localePath, type Lang } from "@/i18n";
import { t } from "@/i18n/ui";
import Base from "@/layouts/Base.astro";
import { breadcrumbSchema, faqSchema, serviceSchema } from "@/lib/schema";

interface Props {
  lang: Lang;
  slug: ServiceSlug;
}

const { lang, slug } = Astro.props;
const ui = t(lang);
const href = (path: string) => localePath(lang, path);
const service = getService(slug);
const c = service.content[lang];
const path = `/services/${slug}/`;
const base = Astro.site ?? Astro.url;
const crumbs = [
  { name: ui.common.home, href: href("/") },
  { name: ui.nav.services, href: href("/services/") },
  { name: c.name, href: href(path) },
];
const ctaCopy = {
  he: {
    title: "נתחיל בבדיקה חינם",
    body: "נבדוק איפה אתם עומדים היום ונראה לכם בדיוק מה הצעד הראשון, בלי התחייבות.",
  },
  en: {
    title: "Start with a free audit",
    body: "We'll check where you stand today and show you exactly what the first step should be. No commitment.",
  },
}[lang];
---

<Base
  lang={lang}
  title={c.metaTitle}
  description={c.metaDescription}
  path={path}
  jsonLd={[
    serviceSchema(lang, base, { name: c.name, description: c.metaDescription, path }),
    faqSchema(c.faqs),
    breadcrumbSchema(base, crumbs),
  ]}
>
  <section class="border-b border-border/60 bg-paper">
    <div class="container-site py-14 sm:py-20 lg:py-24">
      <Breadcrumbs items={crumbs} label={lang === "he" ? "פירורי לחם" : "Breadcrumb"} />
      <div class="mt-10 grid items-end gap-10 lg:grid-cols-[1.6fr_1fr]">
        <div>
          <p class="eyebrow">{c.eyebrow}</p>
          <h1 class="mt-4 text-4xl leading-[1.12] font-extrabold sm:text-5xl">{c.h1}</h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground text-pretty sm:text-xl">{c.intro}</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={`${href("/contact/")}?service=${slug}`} class="btn-primary">
              {ui.cta.audit}
              <Icon name="arrow" class="size-4 flip-rtl" />
            </a>
          </div>
        </div>
        <span class="hidden size-28 items-center justify-center justify-self-end rounded-[2rem] bg-brand text-paper lg:flex" aria-hidden="true">
          <Icon name={service.icon} class="size-12" strokeWidth={1.5} />
        </span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site grid gap-6 lg:grid-cols-[1fr_2fr]">
      <h2 class="text-3xl font-bold sm:text-4xl">{c.problem.title}</h2>
      <p class="text-lg leading-relaxed text-muted-foreground text-pretty sm:text-xl">{c.problem.body}</p>
    </div>
  </section>

  <section class="section border-y border-border/60 bg-paper" aria-labelledby="included-title">
    <div class="container-site">
      <h2 id="included-title" class="text-3xl font-bold sm:text-4xl">{ui.common.whatsIncluded}</h2>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          c.included.map((item) => (
            <li class="card bg-white">
              <span class="flex size-9 items-center justify-center rounded-lg bg-accent/15 text-brand">
                <Icon name="check" class="size-4" strokeWidth={2.5} />
              </span>
              <h3 class="mt-4 text-lg font-semibold">{item.title}</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="process-title">
    <div class="container-site">
      <h2 id="process-title" class="text-3xl font-bold sm:text-4xl">{ui.common.howItWorks}</h2>
      <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {
          c.process.map((step, i) => (
            <li class="border-t-2 border-brand pt-5">
              <span class="text-sm font-semibold text-accent tabular-nums">0{i + 1}</span>
              <h3 class="mt-2 text-xl font-semibold">{step.title}</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="pb-16 sm:pb-20 lg:pb-28">
    <div class="container-site grid gap-5 md:grid-cols-2">
      <div class="card border-accent/30 bg-accent/5">
        <h2 class="text-2xl font-bold">{ui.common.goodFit}</h2>
        <ul class="mt-5 flex flex-col gap-3">
          {
            c.fit.map((line) => (
              <li class="flex gap-3 leading-relaxed">
                <Icon name="check" class="mt-1 size-4 shrink-0 text-accent" strokeWidth={2.5} />
                {line}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="card">
        <h2 class="text-2xl font-bold">{ui.common.notFit}</h2>
        <ul class="mt-5 flex flex-col gap-3">
          {
            c.notFit.map((line) => (
              <li class="flex gap-3 leading-relaxed text-muted-foreground">
                <Icon name="x" class="mt-1 size-4 shrink-0" strokeWidth={2.5} />
                {line}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <div class="bg-paper">
    <Faq title={ui.common.faqTitle} faqs={c.faqs} />
  </div>

  <section class="section" aria-labelledby="related-title">
    <div class="container-site">
      <h2 id="related-title" class="text-2xl font-bold sm:text-3xl">{ui.common.related}</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {
          service.related.map((relatedSlug) => {
            const related = getService(relatedSlug);
            return (
              <a href={href(`/services/${relatedSlug}/`)} class="card group flex items-start gap-5 transition-colors hover:border-brand/40">
                <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-brand text-paper">
                  <Icon name={related.icon} class="size-5" />
                </span>
                <span>
                  <span class="block text-xl font-semibold text-ink group-hover:text-brand">{related.content[lang].name}</span>
                  <span class="mt-1 block text-muted-foreground">{related.content[lang].short}</span>
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <CtaBand lang={lang} title={ctaCopy.title} body={ctaCopy.body} />
</Base>
