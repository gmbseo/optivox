---
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBand from "@/components/CtaBand.astro";
import Faq from "@/components/Faq.astro";
import Icon from "@/components/Icon.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import ServiceVisual from "@/components/ServiceVisual.astro";
import Steps from "@/components/Steps.astro";
import Topo from "@/components/Topo.astro";
import { getService, type ServiceSlug } from "@/content/services";
import { localePath, type Lang } from "@/i18n";
import { t } from "@/i18n/ui";
import Base from "@/layouts/Base.astro";
import { breadcrumbSchema, faqSchema, serviceSchema } from "@/lib/schema";

interface Props {
  lang: Lang;
  slug: ServiceSlug;
}

const { lang, slug } = Astro.props;
const ui = t(lang);
const href = (path: string) => localePath(lang, path);
const service = getService(slug);
const c = service.content[lang];
const path = `/services/${slug}/`;
const base = Astro.site ?? Astro.url;
const crumbs = [
  { name: ui.common.home, href: href("/") },
  { name: ui.nav.services, href: href("/services/") },
  { name: c.name, href: href(path) },
];
const local = {
  he: {
    challenge: "האתגר",
    process: "התהליך",
    ctaTitle: "נתחיל בבדיקה חינם",
    ctaBody: "נבדוק איפה אתם עומדים היום ונראה לכם בדיוק מה הצעד הראשון, בלי התחייבות.",
  },
  en: {
    challenge: "The challenge",
    process: "The process",
    ctaTitle: "Start with a free audit",
    ctaBody: "We'll check where you stand today and show you exactly what the first step should be. No commitment.",
  },
}[lang];
---

<Base
  lang={lang}
  title={c.metaTitle}
  description={c.metaDescription}
  path={path}
  jsonLd={[
    serviceSchema(lang, base, { name: c.name, description: c.metaDescription, path }),
    faqSchema(c.faqs),
    breadcrumbSchema(base, crumbs),
  ]}
>
  <section class="bg-paper">
    <div class="container-site pt-10 pb-16 sm:pt-14 sm:pb-20 lg:pb-24">
      <Breadcrumbs items={crumbs} label={lang === "he" ? "פירורי לחם" : "Breadcrumb"} />
      <div class="mt-10 grid items-center gap-12 lg:mt-14 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
        <div>
          <p class="eyebrow">{c.eyebrow}</p>
          <h1 class="mt-5 text-[2.6rem] leading-[1.06] sm:text-5xl lg:text-6xl">{c.h1}</h1>
          <p class="lead mt-6 max-w-xl">{c.intro}</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={`${href("/contact/")}?service=${slug}`} class="btn-primary">
              {ui.cta.audit}
              <Icon name="arrow" class="size-4 flip-rtl" />
            </a>
            <a href="#included-title" class="btn-secondary">{ui.common.whatsIncluded}</a>
          </div>
        </div>
        <div class="panel-dark flex min-h-[26rem] items-center px-8 pt-10 pb-16 sm:px-14">
          <Topo class="text-paper/[0.08]" />
          <ServiceVisual kind={service.icon} lang={lang} />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-site grid gap-8 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow">{local.challenge}</p>
        <h2 class="h-section mt-4">{c.problem.title}</h2>
      </div>
      <p class="lead lg:pt-12">{c.problem.body}</p>
    </div>
  </section>

  <section class="pb-20 sm:pb-24 lg:pb-32" aria-labelledby="included-title">
    <div class="container-site">
      <h2 id="included-title" class="h-section scroll-mt-28">{ui.common.whatsIncluded}</h2>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          c.included.map((item) => (
            <li class="rounded-[var(--radius-card)] bg-muted p-7 sm:p-8">
              <span class="flex size-10 items-center justify-center rounded-full bg-white text-accent shadow-sm">
                <Icon name="check" class="size-4" strokeWidth={2.75} />
              </span>
              <h3 class="mt-6 text-lg">{item.title}</h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Steps id="process-title" eyebrow={local.process} title={ui.common.howItWorks} steps={c.process} />

  <section class="section">
    <div class="container-site grid gap-5 md:grid-cols-2">
      <div class="panel-dark p-8 sm:p-10">
        <Topo class="text-paper/[0.07]" />
        <h2 class="text-3xl text-paper">{ui.common.goodFit}</h2>
        <ul class="mt-7 flex flex-col gap-4">
          {
            c.fit.map((line) => (
              <li class="flex gap-3 leading-relaxed text-paper/90">
                <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-sun text-ink">
                  <Icon name="check" class="size-3.5" strokeWidth={3} />
                </span>
                {line}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="rounded-[var(--radius-panel)] bg-muted p-8 sm:p-10">
        <h2 class="text-3xl">{ui.common.notFit}</h2>
        <ul class="mt-7 flex flex-col gap-4">
          {
            c.notFit.map((line) => (
              <li class="flex gap-3 leading-relaxed text-muted-foreground">
                <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-white text-muted-foreground">
                  <Icon name="x" class="size-3.5" strokeWidth={3} />
                </span>
                {line}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Faq title={ui.common.faqTitle} faqs={c.faqs} />

  <section class="pb-4" aria-labelledby="related-title">
    <div class="container-site">
      <h2 id="related-title" class="h-section">{ui.common.related}</h2>
      <div class="mt-10 grid gap-5 md:grid-cols-2">
        {service.related.map((relatedSlug, i) => <ServiceCard service={getService(relatedSlug)} lang={lang} index={i + 1} />)}
      </div>
    </div>
  </section>

  <CtaBand lang={lang} title={local.ctaTitle} body={local.ctaBody} />
</Base>
