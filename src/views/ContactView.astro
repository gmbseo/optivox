---
import Icon from "@/components/Icon.astro";
import Topo from "@/components/Topo.astro";
import { site } from "@/config/site";
import { services } from "@/content/services";
import { localePath, type Lang } from "@/i18n";
import { t } from "@/i18n/ui";
import Base from "@/layouts/Base.astro";
import { breadcrumbSchema } from "@/lib/schema";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);
const href = (path: string) => localePath(lang, path);
const base = Astro.site ?? Astro.url;
const crumbs = [
  { name: ui.common.home, href: href("/") },
  { name: ui.nav.contact, href: href("/contact/") },
];

const waLink = `https://wa.me/${site.whatsapp}`;
const brandHtml = `<span dir="ltr" style="unicode-bidi:isolate">Optivox</span>`;
const replyWrap = (dir: "rtl" | "ltr", paragraphs: string[]) => {
  const replyLang = dir === "rtl" ? "he" : "en";
  const align = dir === "rtl" ? "right" : "left";
  return `<div dir="${dir}" lang="${replyLang}" style="font-family:Arial,Helvetica,sans-serif;font-size:16px;line-height:1.7;color:#14262a;text-align:${align}">${paragraphs
    .map((p) => `<p style="margin:0 0 16px">${p}</p>`)
    .join("")}</div>`;
};

const copy = {
  he: {
    metaTitle: "צור קשר ובדיקת נראות חינם",
    metaDescription:
      "צרו קשר עם Optivox או בקשו בדיקת נראות חינם: נבדוק איך העסק מופיע בגוגל, במפות ובמנועי AI.",
    h1: "צור קשר",
    lead: "ספרו לנו בקצרה על העסק. אפשר לשלוח הודעה כללית, או לבקש בדיקת נראות חינם.",
    form: {
      name: "שם מלא",
      business: "שם העסק",
      email: "אימייל",
      phone: "טלפון",
      website: "כתובת האתר",
      websiteHint: "לבדיקת נראות",
      gbp: "קישור מגוגל מפות",
      gbpHint: "לבדיקת נראות",
      gbpPlaceholder: "הדביקו כאן קישור מגוגל מפות",
      service: "במה תרצו שנעזור?",
      notSure: "עוד לא בטוח/ה",
      message: "משהו נוסף שכדאי שנדע?",
      submitContact: "שליחה",
      submitAudit: "בדיקת נראות חינם",
      sending: "שולח…",
      error: "השליחה נכשלה. נסו שוב, או כתבו לנו בוואטסאפ.",
      auditFieldsRequired: "לבדיקת נראות צריך כתובת אתר או קישור מגוגל מפות.",
      privacy: "הפרטים משמשים רק כדי לחזור אליכם בנוגע לפנייה או לבדיקה.",
    },
    replies: {
      contact: {
        subject: "קיבלנו את הפנייה | Optivox",
        html: replyWrap("rtl", [
          "שלום {name},",
          `תודה שפנית ל־${brandHtml}. קיבלנו את הפרטים ונחזור אליך במהרה.`,
          `אם משהו דחוף, אפשר גם בוואטסאפ:<br><a href="${waLink}" dir="ltr" style="unicode-bidi:isolate">${waLink}</a>`,
          brandHtml,
        ]),
      },
      audit: {
        subject: "התחלנו את בדיקת הנראות | Optivox",
        html: replyWrap("rtl", [
          "שלום {name},",
          `תודה! קיבלנו את הבקשה לבדיקת נראות ב־${brandHtml}. אנחנו מתחילים לבדוק את האתר, ותקבלו דוח ראשוני למייל בקרוב.`,
          `אם משהו דחוף, אפשר גם בוואטסאפ:<br><a href="${waLink}" dir="ltr" style="unicode-bidi:isolate">${waLink}</a>`,
          brandHtml,
        ]),
      },
    },
    nextTitle: "מה קורה אחרי השליחה",
    next: ["אנחנו עוברים על הפרטים", "חוזרים אליכם במהרה, או שולחים דוח ראשוני אם ביקשתם בדיקה", "אם מתאים, ממשיכים יחד לשלב הבא"],
    directTitle: "אפשר גם ישירות",
  },
  en: {
    metaTitle: "Contact us and free visibility audit",
    metaDescription:
      "Contact Optivox or request a free visibility audit: we'll check how your business appears on Google, Maps and AI engines.",
    h1: "Contact us",
    lead: "Tell us a little about your business. Send a general message, or request a free visibility audit.",
    form: {
      name: "Full name",
      business: "Business name",
      email: "Email",
      phone: "Phone",
      website: "Website",
      websiteHint: "for visibility audit",
      gbp: "Google Maps link",
      gbpHint: "for visibility audit",
      gbpPlaceholder: "Paste a Google Maps link",
      service: "What can we help with?",
      notSure: "Not sure yet",
      message: "Anything else we should know?",
      submitContact: "Send message",
      submitAudit: "Free visibility audit",
      sending: "Sending…",
      error: "Sending failed. Try again, or message us on WhatsApp.",
      auditFieldsRequired: "For a visibility audit, add a website or a Google Maps link.",
      privacy: "We only use your details to get back to you about this request or audit.",
    },
    replies: {
      contact: {
        subject: "We got your message | Optivox",
        html: replyWrap("ltr", [
          "Hi {name},",
          "Thanks for contacting Optivox. We've received your details and will get back to you shortly.",
          `If something is urgent, you can also message us on WhatsApp:<br><a href="${waLink}" dir="ltr">${waLink}</a>`,
          "Optivox",
        ]),
      },
      audit: {
        subject: "We've started your visibility audit | Optivox",
        html: replyWrap("ltr", [
          "Hi {name},",
          "Thanks! We've received your free visibility audit request. We're checking the site now, and you'll get a short first-pass report by email soon.",
          `If something is urgent, you can also message us on WhatsApp:<br><a href="${waLink}" dir="ltr">${waLink}</a>`,
          "Optivox",
        ]),
      },
    },
    nextTitle: "What happens next",
    next: [
      "We review your details",
      "We get back to you shortly, or email a short report if you asked for an audit",
      "If it's a fit, we move to the next step together",
    ],
    directTitle: "Or reach us directly",
  },
}[lang];

const label = "block text-sm font-medium text-ink";
const input =
  "mt-2 block w-full rounded-xl border border-border bg-white px-4 py-3 text-base text-foreground shadow-xs transition-colors placeholder:text-muted-foreground/70 focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30";
---

<Base lang={lang} title={copy.metaTitle} description={copy.metaDescription} path="/contact/" jsonLd={[breadcrumbSchema(base, crumbs)]}>
  <section class="relative isolate overflow-hidden bg-paper">
    <Topo class="text-brand/[0.06]" />
    <div class="container-site pt-16 pb-20 sm:pt-20 sm:pb-24 lg:pt-24">
      <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr]">
        <div>
          <h1 class="text-5xl leading-[1.05] sm:text-6xl">{copy.h1}</h1>
          <p class="lead mt-6 max-w-2xl">{copy.lead}</p>

          <form
            id="contact-form"
            method="POST"
            action={href("/contact/thanks/")}
            data-sending={copy.form.sending}
            class="card mt-10 grid gap-6 border-t-4 border-t-sun shadow-xl shadow-ink/5 sm:grid-cols-2"
          >
            <input type="hidden" name="flow" value="contact" />
            <input type="hidden" name="language" value={lang} />
            <p class="hidden">
              <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>

            <div>
              <label for="name" class={label}>{copy.form.name} <span class="text-accent" aria-hidden="true">*</span></label>
              <input id="name" name="name" type="text" required autocomplete="name" class={input} />
            </div>
            <div>
              <label for="business" class={label}>{copy.form.business}</label>
              <input id="business" name="business" type="text" autocomplete="organization" class={input} />
            </div>
            <div>
              <label for="email" class={label}>{copy.form.email} <span class="text-accent" aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" required autocomplete="email" dir="ltr" class={input} />
            </div>
            <div>
              <label for="phone" class={label}>{copy.form.phone}</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" dir="ltr" class={input} />
            </div>
            <div class="sm:col-span-2">
              <label for="website" class={label}>
                {copy.form.website}
                <span class="ms-2 text-sm font-normal text-muted-foreground">({copy.form.websiteHint})</span>
              </label>
              <input id="website" name="website" type="text" inputmode="url" autocomplete="url" dir="ltr" placeholder="example.co.il" class={input} />
            </div>
            <div class="sm:col-span-2">
              <label for="gbp" class={label}>
                {copy.form.gbp}
                <span class="ms-2 text-sm font-normal text-muted-foreground">({copy.form.gbpHint})</span>
              </label>
              <input
                id="gbp"
                name="gbp"
                type="text"
                inputmode="url"
                autocomplete="url"
                dir="ltr"
                placeholder={copy.form.gbpPlaceholder}
                class={input}
              />
            </div>
            <div class="sm:col-span-2">
              <label for="service" class={label}>{copy.form.service}</label>
              <select id="service" name="service" class={input}>
                {services.map((s) => <option value={s.slug}>{s.content[lang].name}</option>)}
                <option value="not-sure" selected>{copy.form.notSure}</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label for="message" class={label}>{copy.form.message}</label>
              <textarea id="message" name="message" rows="4" dir="auto" class={input}></textarea>
            </div>
            <p
              data-form-error
              data-default-error={copy.form.error}
              data-audit-fields-error={copy.form.auditFieldsRequired}
              class="hidden text-sm text-red-700 sm:col-span-2"
              role="alert"
            >
              {copy.form.error}
            </p>
            <p class="text-sm text-muted-foreground sm:col-span-2">{copy.form.privacy}</p>
            <div class="flex flex-col gap-3 sm:col-span-2 sm:flex-row sm:flex-wrap">
              <button type="submit" data-flow="contact" class="btn-secondary shrink-0 disabled:pointer-events-none disabled:opacity-60">
                <span data-submit-label>{copy.form.submitContact}</span>
              </button>
              <button type="submit" data-flow="audit" class="btn-primary shrink-0 disabled:pointer-events-none disabled:opacity-60">
                <span data-submit-label>{copy.form.submitAudit}</span>
                <Icon name="arrow" class="size-4 flip-rtl" />
              </button>
            </div>
          </form>
        </div>

        <aside class="flex flex-col gap-5 lg:pt-44">
          <div class="panel-dark p-7 sm:p-9">
            <Topo class="text-paper/[0.07]" />
            <h2 class="text-2xl text-paper">{copy.nextTitle}</h2>
            <ol class="mt-6 flex flex-col gap-5">
              {
                copy.next.map((step, i) => (
                  <li class="flex gap-4">
                    <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-sun text-sm font-semibold text-ink">{i + 1}</span>
                    <span class="leading-relaxed text-paper/85">{step}</span>
                  </li>
                ))
              }
            </ol>
          </div>
          <div class="card">
            <h2 class="text-2xl">{copy.directTitle}</h2>
            <ul class="mt-5 flex flex-col gap-3">
              {
                site.email && (
                  <li>
                    <a href={`mailto:${site.email}`} class="inline-flex items-center gap-3 text-foreground hover:text-brand">
                      <Icon name="mail" class="size-4 text-accent" />
                      <span dir="ltr">{site.email}</span>
                    </a>
                  </li>
                )
              }
              {
                site.phone && (
                  <li>
                    <a href={`tel:${site.phone.replace(/[^\d+]/g, "")}`} class="inline-flex items-center gap-3 text-foreground hover:text-brand">
                      <Icon name="phone" class="size-4 text-accent" />
                      <span dir="ltr">{site.phone}</span>
                    </a>
                  </li>
                )
              }
              {
                site.whatsapp && (
                  <li>
                    <a href={`https://wa.me/${site.whatsapp}`} rel="noopener" class="inline-flex items-center gap-3 text-foreground hover:text-brand">
                      <Icon name="chat" class="size-4 text-accent" />
                      WhatsApp
                    </a>
                  </li>
                )
              }
              {
                site.address.mapsUrl && (
                  <li class="il-only">
                    <a
                      href={site.address.mapsUrl}
                      target="_blank"
                      rel="noopener"
                      class="inline-flex items-start gap-3 text-foreground hover:text-brand"
                    >
                      <Icon name="pin" class="mt-0.5 size-4 shrink-0 text-accent" />
                      <span>{site.address[lang]}</span>
                    </a>
                  </li>
                )
              }
            </ul>
            {
              site.address.embedUrl && (
                <div class="il-only mt-6 overflow-hidden rounded-xl border border-border">
                  <iframe
                    title={site.address[lang]}
                    src={site.address.embedUrl}
                    class="aspect-[4/3] w-full border-0"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen
                  />
                </div>
              )
            }
          </div>
        </aside>
      </div>
    </div>
  </section>
</Base>

<pre id="contact-replies" hidden>{JSON.stringify(copy.replies)}</pre>

<script>
  type Flow = "contact" | "audit";

  const requested = new URLSearchParams(window.location.search).get("service");
  const select = document.querySelector<HTMLSelectElement>("#service");
  if (requested && select && [...select.options].some((o) => o.value === requested)) {
    select.value = requested;
  }

  const field = (form: HTMLFormElement, name: string) =>
    (form.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`[name="${name}"]`)?.value ?? "").trim();

  const form = document.querySelector<HTMLFormElement>("#contact-form");
  if (form) {
    const errorEl = form.querySelector<HTMLElement>("[data-form-error]");
    const flowInput = form.querySelector<HTMLInputElement>('[name="flow"]');
    const website = form.querySelector<HTMLInputElement>("#website");
    const buttons = [...form.querySelectorAll<HTMLButtonElement>('button[type="submit"]')];
    const replies = JSON.parse(document.getElementById("contact-replies")?.textContent ?? "{}") as Record<
      Flow,
      { subject?: string; html?: string }
    >;
    let activeFlow: Flow = "contact";

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        activeFlow = button.dataset.flow === "audit" ? "audit" : "contact";
        if (flowInput) flowInput.value = activeFlow;
      });
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      const honeypot = form.querySelector<HTMLInputElement>('[name="bot-field"]');
      if (honeypot?.value) {
        window.location.assign(form.action);
        return;
      }

      const flow = activeFlow;
      if (flowInput) flowInput.value = flow;

      if (flow === "audit" && !field(form, "website") && !field(form, "gbp")) {
        if (errorEl) {
          errorEl.textContent = errorEl.dataset.auditFieldsError ?? errorEl.dataset.defaultError ?? "";
          errorEl.classList.remove("hidden");
        }
        website?.focus();
        return;
      }

      const webhook = import.meta.env.PUBLIC_MAKE_WEBHOOK_URL ?? "";
      const name = field(form, "name");
      const reply = replies[flow];
      const idleLabels = new Map(buttons.map((button) => [button, button.querySelector("[data-submit-label]")?.textContent ?? ""]));

      errorEl?.classList.add("hidden");
      buttons.forEach((button) => {
        button.disabled = true;
        const label = button.querySelector("[data-submit-label]");
        if (label && button.dataset.flow === flow) label.textContent = form.dataset.sending ?? idleLabels.get(button) ?? "";
      });

      try {
        if (!webhook) throw new Error("Make webhook is not configured");
        const response = await fetch(webhook, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            flow,
            name,
            business: field(form, "business"),
            email: field(form, "email"),
            phone: field(form, "phone"),
            website: field(form, "website"),
            gbp: field(form, "gbp"),
            service: field(form, "service"),
            language: field(form, "language"),
            origin: location.origin,
            message: field(form, "message"),
            reply_subject: reply?.subject ?? "",
            reply_html: (reply?.html ?? "").replaceAll("{name}", name),
          }),
        });
        if (!response.ok) throw new Error(`Make webhook ${response.status}`);
        const thanks = new URL(form.action, location.origin);
        thanks.searchParams.set("flow", flow);
        window.location.assign(thanks.toString());
      } catch {
        buttons.forEach((button) => {
          button.disabled = false;
          const label = button.querySelector("[data-submit-label]");
          if (label) label.textContent = idleLabels.get(button) ?? "";
        });
        if (errorEl) {
          errorEl.textContent = errorEl.dataset.defaultError ?? "";
          errorEl.classList.remove("hidden");
        }
      }
    });
  }
</script>
