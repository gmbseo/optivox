---
import "@/styles/global.css";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Seo from "@/components/Seo.astro";
import { langMeta, type Lang } from "@/i18n";
import { t } from "@/i18n/ui";
import { organizationSchema, websiteSchema } from "@/lib/schema";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { lang, title, description, path, noindex, jsonLd = [] } = Astro.props;
const base = Astro.site ?? Astro.url;
const schemas = [organizationSchema(lang, base), websiteSchema(lang, base), ...jsonLd];
---

<!doctype html>
<html lang={lang} dir={langMeta[lang].dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f2e7" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.jpeg" type="image/jpeg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo lang={lang} title={title} description={description} path={path} noindex={noindex} jsonLd={schemas} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      {t(lang).skipToContent}
    </a>
    <Header lang={lang} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
