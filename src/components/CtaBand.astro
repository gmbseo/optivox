---
import { localePath, type Lang } from "@/i18n";
import { t } from "@/i18n/ui";
import Icon from "./Icon.astro";
import Topo from "./Topo.astro";

interface Props {
  lang: Lang;
  title: string;
  body: string;
  class?: string;
}

const { lang, title, body, class: className } = Astro.props;
const copy = t(lang);
---

<section class:list={["py-16 sm:py-20 lg:py-24", className]}>
  <div class="container-site">
    <div class="panel-dark px-6 py-16 text-center sm:px-12 sm:py-20 lg:py-24">
      <Topo class="text-paper/[0.08]" />
      <h2 class="h-section mx-auto max-w-3xl text-paper">{title}</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-paper/75 text-pretty">{body}</p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href={localePath(lang, "/contact/")} class="btn-sun">
          {copy.cta.audit}
          <Icon name="arrow" class="size-4 flip-rtl" />
        </a>
        <a href={localePath(lang, "/services/")} class="btn-on-dark">{copy.cta.services}</a>
      </div>
    </div>
  </div>
</section>
