---
import CarouselControls from "@/components/CarouselControls.astro";
import { type Lang } from "@/i18n";
import { t } from "@/i18n/ui";
import Topo from "./Topo.astro";

interface Props {
  id: string;
  lang: Lang;
  title: string;
  eyebrow?: string;
  intro?: string;
  steps: readonly { title: string; body: string }[];
  class?: string;
}

const { id, lang, title, eyebrow, intro, steps, class: className } = Astro.props;
const ui = t(lang);
---

<section class:list={["section relative isolate overflow-hidden border-y border-border/70", className]} aria-labelledby={id}>
  <Topo class="text-brand/[0.08]" />
  <div class="container-site">
    <div class="mx-auto max-w-2xl text-center">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id={id} class="h-section mt-4">{title}</h2>
      {intro && <p class="lead mt-5">{intro}</p>}
    </div>
    <div class="mt-14" data-carousel>
      <ol
        data-carousel-track
        class="flex snap-x snap-mandatory overflow-x-auto rounded-[var(--radius-card)] border-t-4 border-sun bg-white shadow-xl shadow-ink/5 [-ms-overflow-style:none] [scrollbar-width:none] md:grid md:grid-cols-2 md:overflow-visible lg:grid-cols-4 [&::-webkit-scrollbar]:hidden"
      >
        {
          steps.map((step, i) => (
            <li class="relative w-[min(100%,18.5rem)] shrink-0 snap-start border-border p-8 not-last:border-e sm:w-[min(100%,22rem)] sm:p-9 md:w-auto md:snap-align-none md:border-b md:odd:border-e md:[&:nth-child(n+3)]:border-b-0 lg:border-b-0 lg:not-last:border-e">
              <span class="font-display text-5xl font-medium text-brand/15 tabular-nums">0{i + 1}</span>
              <h3 class="mt-4 text-xl">{step.title}</h3>
              <p class="mt-3 leading-relaxed text-muted-foreground">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <CarouselControls
        count={steps.length}
        prevLabel={ui.common.prev}
        nextLabel={ui.common.next}
        goToLabel={ui.common.goToSlide}
      />
    </div>
  </div>
</section>
