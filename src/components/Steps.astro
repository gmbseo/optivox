---
import Topo from "./Topo.astro";

interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  intro?: string;
  steps: readonly { title: string; body: string }[];
  class?: string;
}

const { id, title, eyebrow, intro, steps, class: className } = Astro.props;
---

<section class:list={["section relative isolate overflow-hidden border-y border-border/70", className]} aria-labelledby={id}>
  <Topo class="text-brand/[0.08]" />
  <div class="container-site">
    <div class="mx-auto max-w-2xl text-center">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2 id={id} class="h-section mt-4">{title}</h2>
      {intro && <p class="lead mt-5">{intro}</p>}
    </div>
    <ol class="mt-14 grid overflow-hidden rounded-[var(--radius-card)] border-t-4 border-sun bg-white shadow-xl shadow-ink/5 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((step, i) => (
          <li class="relative border-border p-8 not-last:border-b sm:p-9 sm:odd:border-e sm:[&:nth-child(n+3)]:border-b-0 lg:border-b-0 lg:not-last:border-e">
            <span class="font-display text-5xl font-medium text-brand/15 tabular-nums">0{i + 1}</span>
            <h3 class="mt-4 text-xl">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-muted-foreground">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
