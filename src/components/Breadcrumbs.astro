---
interface Props {
  items: readonly { name: string; href: string }[];
  label: string;
}

const { items, label } = Astro.props;
---

<nav aria-label={label} class="text-sm text-muted-foreground">
  <ol class="flex flex-wrap items-center gap-2">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {i === items.length - 1 ? (
            <span aria-current="page" class="text-foreground">{item.name}</span>
          ) : (
            <a href={item.href} class="hover:text-foreground">{item.name}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
