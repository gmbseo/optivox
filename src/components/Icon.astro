} as const;

export type IconName = keyof typeof paths;

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = "size-5", strokeWidth = 2 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={paths[name]}
/>
