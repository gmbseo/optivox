---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  intro?: string;
  faqs: readonly { q: string; a: string }[];
  class?: string;
}

const { title, intro, faqs, class: className } = Astro.props;
---

<section class:list={["section", className]} aria-labelledby="faq-title">
  <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.8fr] lg:gap-20">
    <div>
      <h2 id="faq-title" class="h-section">{title}</h2>
      {intro && <p class="lead mt-5">{intro}</p>}
    </div>
    <div class="flex flex-col gap-3">
      {
        faqs.map((f) => (
          <details class="group rounded-2xl bg-muted px-6 transition-colors open:bg-white open:shadow-lg open:shadow-ink/5 open:ring-1 open:ring-border sm:px-7">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
              <h3 class="text-lg">{f.q}</h3>
              <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-white text-brand transition-transform group-open:rotate-45 group-open:bg-brand group-open:text-paper">
                <Icon name="plus" class="size-4" />
              </span>
            </summary>
            <p class="max-w-3xl pb-6 leading-relaxed text-muted-foreground">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
