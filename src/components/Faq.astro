---
import Icon from "./Icon.astro";

interface Props {
  title: string;
  faqs: readonly { q: string; a: string }[];
}

const { title, faqs } = Astro.props;
---

<section class="section" aria-labelledby="faq-title">
  <div class="container-site grid gap-10 lg:grid-cols-[1fr_2fr]">
    <h2 id="faq-title" class="text-3xl font-bold sm:text-4xl">{title}</h2>
    <div class="divide-y divide-border border-y border-border">
      {
        faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold text-ink [&::-webkit-details-marker]:hidden">
              <h3 class="text-lg font-semibold">{f.q}</h3>
              <Icon name="chevron-down" class="size-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" />
            </summary>
            <p class="mt-3 max-w-3xl leading-relaxed text-muted-foreground">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
