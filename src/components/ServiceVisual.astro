---
import type { Lang } from "@/i18n";
import Icon from "./Icon.astro";

interface Props {
  kind: "web" | "search" | "ai";
  lang: Lang;
  class?: string;
}

const { kind, lang, class: className = "" } = Astro.props;

const copy = {
  he: {
    url: "yourbusiness.co.il",
    speed: "מהירות טעינה",
    speedValue: "מצוינת",
    query: "רואה חשבון ברמת גן",
    you: "העסק שלכם",
    rank: "דירוג בגוגל",
    rankValue: "במגמת עלייה",
    ask: "על איזה רואה חשבון ברמת גן אתה ממליץ?",
    answer: "כמה משרדים מומלצים באזור:",
    sources: "מקור: האתר שלכם",
    mentioned: "אזכור בתשובות AI",
  },
  en: {
    url: "yourbusiness.com",
    speed: "Page speed",
    speedValue: "Excellent",
    query: "accountant tel aviv",
    you: "Your business",
    rank: "Google ranking",
    rankValue: "Trending up",
    ask: "Which accountant in Tel Aviv do you recommend?",
    answer: "A few well-reviewed firms nearby:",
    sources: "Source: your website",
    mentioned: "Mentioned in AI answers",
  },
}[lang];

const badge = "absolute flex items-center gap-3 rounded-2xl bg-white px-4 py-3 text-start shadow-xl shadow-ink/25";
const bar = "rounded-full bg-ink/10";
---

<div class:list={["relative mx-auto w-full max-w-sm", className]} aria-hidden="true">
  {
    kind === "web" && (
      <>
        <div class="overflow-hidden rounded-2xl bg-white shadow-2xl shadow-ink/30">
          <div class="flex items-center gap-1.5 border-b border-border bg-muted px-4 py-3">
            <span class="size-2.5 rounded-full bg-ink/15" />
            <span class="size-2.5 rounded-full bg-ink/15" />
            <span class="size-2.5 rounded-full bg-ink/15" />
            <span class="ms-3 flex-1 truncate rounded-full bg-white px-3 py-0.5 text-[11px] text-muted-foreground" dir="ltr">
              {copy.url}
            </span>
          </div>
          <div class="p-5">
            <div class="h-2 w-14 rounded-full bg-accent/50" />
            <div class="mt-3 h-3.5 w-4/5 rounded-full bg-ink/85" />
            <div class="mt-2 h-3.5 w-3/5 rounded-full bg-ink/85" />
            <div class:list={[bar, "mt-4 h-2 w-full"]} />
            <div class:list={[bar, "mt-2 h-2 w-11/12"]} />
            <div class="mt-5 flex gap-2">
              <div class="h-7 w-24 rounded-full bg-accent" />
              <div class="h-7 w-16 rounded-full bg-ink/10" />
            </div>
            <div class="mt-5 grid grid-cols-3 gap-2">
              <div class="h-12 rounded-lg bg-muted" />
              <div class="h-12 rounded-lg bg-muted" />
              <div class="h-12 rounded-lg bg-muted" />
            </div>
          </div>
        </div>
        <div class:list={[badge, "-bottom-6 -end-3"]}>
          <svg viewBox="0 0 36 36" class="size-10 -rotate-90">
            <circle cx="18" cy="18" r="15" fill="none" stroke="currentColor" stroke-width="4" class="text-accent/15" />
            <circle cx="18" cy="18" r="15" fill="none" stroke="currentColor" stroke-width="4" stroke-dasharray="94.2" stroke-dashoffset="4" stroke-linecap="round" class="text-accent" />
          </svg>
          <span>
            <span class="block text-xs text-muted-foreground">{copy.speed}</span>
            <span class="block text-sm font-semibold text-ink">{copy.speedValue}</span>
          </span>
        </div>
      </>
    )
  }

  {
    kind === "search" && (
      <>
        <div class="rounded-2xl bg-white p-5 shadow-2xl shadow-ink/30">
          <div class="flex items-center gap-2.5 rounded-full border border-border px-4 py-2 text-xs text-foreground">
            <Icon name="search" class="size-3.5 text-muted-foreground" />
            <span class="truncate">{copy.query}</span>
          </div>
          <ol class="mt-4 flex flex-col gap-2">
            <li class="flex items-center gap-3 rounded-xl bg-accent/10 p-3 ring-1 ring-accent/30">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-accent text-[11px] font-bold text-white">1</span>
              <span class="min-w-0 flex-1">
                <span class="block truncate text-sm font-semibold text-brand">{copy.you}</span>
                <span class="mt-1.5 block h-1.5 w-2/3 rounded-full bg-accent/30" />
              </span>
            </li>
            {[2, 3].map((n) => (
              <li class="flex items-center gap-3 p-3">
                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-ink/5 text-[11px] font-semibold text-muted-foreground">{n}</span>
                <span class="flex-1">
                  <span class="block h-2 w-3/4 rounded-full bg-ink/15" />
                  <span class="mt-1.5 block h-1.5 w-1/2 rounded-full bg-ink/10" />
                </span>
              </li>
            ))}
          </ol>
          <svg viewBox="0 0 300 80" class="mt-2 h-16 w-full text-accent" preserveAspectRatio="none">
            <defs>
              <linearGradient id="seo-area" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="currentColor" stop-opacity="0.25" />
                <stop offset="1" stop-color="currentColor" stop-opacity="0" />
              </linearGradient>
            </defs>
            <path d="M0 70 L40 62 L80 66 L120 48 L160 52 L200 32 L240 26 L300 8 L300 80 L0 80Z" fill="url(#seo-area)" />
            <path d="M0 70 L40 62 L80 66 L120 48 L160 52 L200 32 L240 26 L300 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
          </svg>
        </div>
        <div class:list={[badge, "-bottom-6 -start-3"]}>
          <span class="flex size-10 items-center justify-center rounded-full bg-accent/15 text-accent">
            <Icon name="chart" class="size-5" />
          </span>
          <span>
            <span class="block text-xs text-muted-foreground">{copy.rank}</span>
            <span class="block text-sm font-semibold text-ink">{copy.rankValue}</span>
          </span>
        </div>
      </>
    )
  }

  {
    kind === "ai" && (
      <>
        <div class="rounded-2xl bg-white p-5 shadow-2xl shadow-ink/30">
          <p class="ms-auto w-fit max-w-[88%] rounded-2xl rounded-ee-md bg-ink px-4 py-2.5 text-xs leading-relaxed text-paper">{copy.ask}</p>
          <div class="mt-4 flex gap-3">
            <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-brand text-sun">
              <Icon name="ai" class="size-3.5" />
            </span>
            <div class="min-w-0 flex-1 rounded-2xl rounded-ss-md bg-muted p-3.5 text-xs text-foreground">
              <p>{copy.answer}</p>
              <ol class="mt-2.5 flex flex-col gap-2">
                <li class="flex items-center gap-2 rounded-lg bg-white px-2.5 py-1.5 font-semibold text-brand ring-1 ring-accent/30">
                  <Icon name="star" class="size-3 fill-sun text-sun" />
                  {copy.you}
                </li>
                <li class="flex items-center gap-2 px-2.5">
                  <span class="h-1.5 w-1/2 rounded-full bg-ink/15" />
                </li>
                <li class="flex items-center gap-2 px-2.5">
                  <span class="h-1.5 w-2/5 rounded-full bg-ink/15" />
                </li>
              </ol>
              <p class="mt-3 inline-flex rounded-full bg-accent/10 px-2.5 py-1 text-[11px] font-medium text-brand">{copy.sources}</p>
            </div>
          </div>
        </div>
        <div class:list={[badge, "-bottom-6 -end-3"]}>
          <span class="flex size-10 items-center justify-center rounded-full bg-sun-soft text-ink">
            <Icon name="ai" class="size-5" />
          </span>
          <span>
            <span class="block text-xs text-muted-foreground">{copy.mentioned}</span>
            <span class="block text-sm font-semibold text-ink" dir="ltr">ChatGPT · Gemini</span>
          </span>
        </div>
      </>
    )
  }
</div>
