---
import type { Service } from "@/content/services";
import { localePath, type Lang } from "@/i18n";
import { t } from "@/i18n/ui";
import Icon from "./Icon.astro";
import ServiceVisual from "./ServiceVisual.astro";
import Topo from "./Topo.astro";

interface Props {
  service: Service;
  lang: Lang;
  index?: number;
  headingLevel?: "h2" | "h3";
}

const { service, lang, index = 0, headingLevel: Heading = "h3" } = Astro.props;
const c = service.content[lang];
const tone = ["bg-brand", "bg-ink", "bg-brand-deep"][index % 3];
---

<a
  href={localePath(lang, `/services/${service.slug}/`)}
  class:list={["group relative isolate flex min-h-[33rem] flex-col overflow-hidden rounded-[var(--radius-panel)] p-7 text-paper sm:p-9", tone]}
>
  <Topo class="text-paper/[0.07]" />
  <div class="flex flex-1 items-center pb-14 pt-2 transition-transform duration-500 ease-out group-hover:-translate-y-1.5">
    <ServiceVisual kind={service.icon} lang={lang} />
  </div>
  <div>
    <span class="flex size-12 items-center justify-center rounded-full bg-paper text-brand">
      <Icon name={service.icon} class="size-5" />
    </span>
    <Heading class="mt-5 font-display text-3xl font-medium text-paper">{c.name}</Heading>
    <p class="mt-3 leading-relaxed text-paper/75">{c.short}</p>
    <span class="mt-6 inline-flex items-center gap-2 font-semibold text-sun">
      {t(lang).common.learnMore}
      <Icon name="arrow" class="size-4 flip-rtl transition-transform group-hover:translate-x-1 rtl:group-hover:-translate-x-1" />
    </span>
  </div>
</a>
